# Copie para .env e preencha. O .env NÃO é versionado.
#
# Regra do vortexOS: segredo só em .env ou cofre — nunca em código, JSON,
# nota ou log. Este arquivo diz QUAIS variáveis existem, jamais os valores.

# --- Desenvolvimento: as partes separadas -----------------------------------
# A SENHA VAI CRUA, exatamente como você a digitou no PostgreSQL.
# Não codifique nada, não use aspas: o código cuida disso.
# Pode conter #, @, /, %, espaço — tanto faz.

CRM_DB_USER=criterio_crm
CRM_DB_PASSWORD=
CRM_DB_HOST=localhost
CRM_DB_PORT=5432
CRM_DB_NAME=criterio_crm

# --- Nuvem: o endereço inteiro ----------------------------------------------
# Provedor de nuvem entrega a conexão assim, já pronta. Quando houver uma,
# ela tem precedência sobre as partes acima e o resto pode sair daqui.
#
# CRM_DATABASE_URL=postgresql+psycopg://usuario:senha@servidor:5432/banco
