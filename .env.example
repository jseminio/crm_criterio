# Variáveis do docker-compose.yml (stack LOCAL de ensaio: PostgreSQL + API + tela).
# Copie para .env (o .env não é versionado) e preencha. No servidor, as variáveis vão no painel do
# Coolify, não aqui: ver app/IMPLANTACAO.md, seção "Coolify".

# --- Login (obrigatórias: sem elas a API não sobe) ---------------------------
CRM_ADMIN_EMAIL=
# 8 caracteres ou mais. Só semeia: depois de trocada na tela, mudar aqui não muda nada.
CRM_ADMIN_SENHA_INICIAL=
# Gere com: openssl rand -hex 32
CRM_SEGREDO_SESSAO=

# --- Banco local do compose ---------------------------------------------------
# Senha do PostgreSQL do container (vai crua na URL interna: use só letras e números).
POSTGRES_PASSWORD=crmcs_local
# Porta do PostgreSQL em 127.0.0.1 (psql, backup). 5432 fica para o PostgreSQL da máquina.
POSTGRES_PORT=55433

# --- Tela ---------------------------------------------------------------------
# Porta da tela em 127.0.0.1 (abra http://localhost:8080).
FRONTEND_PORT=8080

# --- Opcionais (as mesmas do app/backend/.env.example) -----------------------
ANTHROPIC_API_KEY=
CRM_AGENTE_MODELO=
CRM_M365_TENANT_ID=
CRM_M365_CLIENT_ID=
CRM_M365_CLIENT_SECRET=
CRM_M365_REMETENTE=
CRM_QUESTIONARIO_URL=
CRM_QUESTIONARIO_CHAVE=
